{
  "compilerOptions": {
    "noImplicitAny": false,
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,

    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "experimentalDecorators": true,
    "baseUrl": "."
  },
  "include": [
    "./**/*.js",
    "./**/*.ts"
  ]
}
