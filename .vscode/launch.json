{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Push to GitHub",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/push-wrapper.ps1"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "✏️ Push with Custom Message",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$msg = Read-Host 'Enter commit message'; & '${workspaceFolder}/push-wrapper.ps1' $msg"
      ],
      "console": "integratedTerminal"
    }
  ]
}
